# Keep launcher scripts LF so they behave identically on Windows and Linux.
bin/tooluniverse-osteo.js text eol=lf
# Shell scripts MUST stay LF: a CRLF shebang breaks them on Linux with a
# "bad interpreter: /usr/bin/env bash^M" error. The synced machines are Windows
# and Linux, so the .sh hooks run on Linux and cannot tolerate CRLF.
*.sh text eol=lf
# JSON config files: LF so Windows/Linux share them without CRLF churn.
settings.json text eol=lf
.mcp.json text eol=lf
