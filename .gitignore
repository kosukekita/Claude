# Sensitive Data
settings.local.json
.credentials.json
client_secret_*.json
mcp-needs-auth-cache.json
.env
.env.local

# Nested .claude (prevent .claude/.claude)
.claude/

# Hook Logs
command-log.txt

# Local State (machine-specific, not for sharing)
.playwright-cli/
backups/
cache/
daemon/
uploads/
debug/
file-history/
history.jsonl
ide/
plans/
projects/
session-env/
shell-snapshots/
stats-cache.json
telemetry/
todos/
plugins/
memory/
statsig/
nul
sessions/
downloads/*.exe
security/
tasks/
.last-cleanup
.last-update-result.json
settings.json.bak.*

# Exception: cross-PC memory store must be synced (conversation history under
# projects/ stays ignored, but the memory/ folder inside it is shared).
# Re-allow each path segment down to the memory files (git won't descend into an
# ignored parent dir, so every intermediate level must be un-ignored first).
!projects/
projects/*
!projects/c--Users-u8792--claude/
projects/c--Users-u8792--claude/*
!projects/c--Users-u8792--claude/memory/
!projects/c--Users-u8792--claude/memory/**
