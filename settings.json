{
  "permissions": {
    "allow": [
      "Bash(git init:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(rm settings.json.bak)",
      "Bash(git branch:*)",
      "Bash(python3)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(git config:*)",
      "Read(//c/Users/kitak/.local/bin/**)",
      "Read(//c/Users/kitak/.cargo/bin/**)",
      "Read(//c/Users/kitak/**)",
      "Bash(git push:*)",
      "Bash(powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\")",
      "Bash(export PATH=\"/c/Users/kitak/.local/bin:$PATH\")",
      "Bash(uv run:*)",
      "Bash(export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$PATH\")",
      "Bash(uv --version)",
      "WebFetch(domain:amedfind.amed.go.jp)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" -X POST \"https://amedfind.amed.go.jp/amed/web/api/theme-list\" -H \"Content-Type: application/json\" -d '{\"periodFrom\":\"2022\",\"periodTo\":\"2026\",\"page\":1,\"size\":20}')",
      "Skill(browser-automation)",
      "Skill(browser-automation:*)",
      "Bash(playwright-cli open:*)",
      "Bash(where playwright-cli:*)",
      "Bash(npx playwright-cli:*)",
      "Bash(where uv:*)",
      "Bash(where python:*)",
      "Bash(where pip:*)",
      "Bash(where node:*)",
      "Bash(where npx:*)",
      "Bash(cmd.exe /c \"where uv & where python & where pip & where node & where npx\")",
      "Bash(cmd.exe /c \"where uv\")",
      "Bash(cmd.exe /c \"where python\")",
      "Bash(cmd.exe /c \"where node\")",
      "Bash(pip --version)",
      "Bash(python -m pip --version)",
      "Bash(python -m playwright install chromium)",
      "Bash(npm list:*)",
      "Read(//usr/local/**)",
      "Bash(npm root:*)",
      "Read(//c/ProgramData/**)",
      "Bash(winget --version)",
      "Bash(winget list:*)",
      "Bash(winget install:*)",
      "Bash(npm --version)",
      "Bash(npm install:*)",
      "Bash(playwright-cli --version)",
      "Bash(npm uninstall:*)",
      "Bash(playwright-cli snapshot:*)",
      "Bash(playwright-cli close:*)",
      "Bash(python -c ':*)",
      "WebFetch(domain:doi.org)",
      "Bash(gemini --version)",
      "Edit(~/.claude/skills/ui-ux-design/**)",
      "Bash(codex --version)",
      "Bash(codex exec:*)",
      "WebFetch(domain:status.openai.com)",
      "Bash(chmod 600 ~/.ssh/xs575794.key)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/block-dangerous.ps1\"; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/log-commands.ps1\"; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/warn-tu-encoding.ps1\"; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/protect-files.ps1\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/auto-pull.ps1\"; else bash \"$HOME/.claude/hooks/auto-pull.sh\"; fi",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "command -v powershell >/dev/null 2>&1 && powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/memory-inject.ps1\" || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "command -v powershell >/dev/null 2>&1 && powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/memory-sync-codex.ps1\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v powershell >/dev/null 2>&1 && powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/memory-sync-codex.ps1\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if command -v powershell >/dev/null 2>&1; then powershell -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/auto-push.ps1\"; else bash \"$HOME/.claude/hooks/auto-push.sh\"; fi",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "codex@openai-codex": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "xhigh",
  "ultracode": true,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
