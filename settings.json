{
  "permissions": {
    "allow": [
      "Bash(git init:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(git config:*)",
      "Bash(git push:*)",
      "Bash(python3)",
      "Bash(python -c ':*)",
      "Bash(python -m pip --version)",
      "Bash(python -m playwright install chromium)",
      "Bash(pip --version)",
      "Bash(uv run:*)",
      "Bash(uv --version)",
      "Bash(export PATH=\"$HOME/.local/bin:$HOME/.cargo/bin:$PATH\")",
      "Bash(powershell -ExecutionPolicy ByPass -c \"irm https://astral.sh/uv/install.ps1 | iex\")",
      "Bash(npm --version)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm list:*)",
      "Bash(npm root:*)",
      "Bash(where:*)",
      "Bash(cmd.exe /c \"where uv & where python & where pip & where node & where npx\")",
      "Bash(winget --version)",
      "Bash(winget list:*)",
      "Bash(winget install:*)",
      "Bash(playwright-cli open:*)",
      "Bash(playwright-cli --version)",
      "Bash(playwright-cli snapshot:*)",
      "Bash(playwright-cli close:*)",
      "Bash(npx playwright-cli:*)",
      "Bash(gemini --version)",
      "Bash(codex --version)",
      "Bash(codex exec:*)",
      "Read(//usr/local/**)",
      "Read(//c/ProgramData/**)",
      "WebFetch(domain:amedfind.amed.go.jp)",
      "WebFetch(domain:doi.org)",
      "WebFetch(domain:status.openai.com)",
      "Skill(browser-automation:*)",
      "Edit(~/.claude/skills/ui-ux-design/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "fallbackModel": [
    "opus[1m]"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" warn-tu-encoding",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" guard-file-revert"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" warn-bash-overwrite"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" guard-destructive-and-resolution",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" guard-charsheet-missing",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pixel-agents-shim.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Users\\u8792\\.pixel-agents\\hooks\\claude-hook.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/hook-health-check.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" auto-pull",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" memory-inject",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" memory-inject-project",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/dispatch.js\" memory-sync-codex",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/pixel-agents-shim.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:\\Users\\u8792\\.pixel-agents\\hooks\\claude-hook.js\"",
            "timeout": 5
